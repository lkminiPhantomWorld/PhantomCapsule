<script>
function statusData(){return JSON.parse(document.getElementById("public-capsule-status").textContent)}
function showPanel(id){document.querySelectorAll(".panel").forEach(p=>p.classList.remove("active"));document.getElementById(id).classList.add("active");if(id==="status")document.getElementById("status-output").textContent=JSON.stringify(statusData(),null,2)}
