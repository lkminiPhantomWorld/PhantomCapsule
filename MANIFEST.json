{
  "name": "PhantomCapsule",
  "display_name": "🪞幻影膠囊｜PhantomCapsule",
  "version": "public_capsule_v1",
  "repository": "lkminiPhantomWorld/PhantomCapsule",
  "default_branch": "master",
  "root": "🧩LKMINI",
  "axiom": "A=A",
  "scope": "public reusable capsule template",
  "private_core_included": false,
  "namespace": {
    "root": "LKMINI::PhantomCapsule",
    "format": "LKMINI::PhantomCapsule::<Layer>::<Name>",
    "extensionless_capsule": true,
    "namespace_is_program": false,
    "layers": [
      {
        "name": "Core",
        "purpose": "Identity, coordinates, and immutable rules"
      },
      {
        "name": "Public",
        "purpose": "Public template and shareable content"
      },
      {
        "name": "Reverse",
        "purpose": "ReverseChain and lineage tracing"
      },
      {
        "name": "Display",
        "purpose": "Presentation and projection rules"
      }
    ],
    "applies_to": ["code", "json", "docs"]
  },
  "files": [
    "README.md",
    "LICENSE",
    "MANIFEST.json",
    "LOCATOR.json",
    "SNAPSHOT.json",
    "ReverseChain.json",
    "SHA256SUMS",
    "PACKAGE.md"
  ]
}